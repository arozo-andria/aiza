# Which STT engine app/api/transcribe/route.ts uses. Only "sahara" ships in
# the product (per the challenge's guidance); the 3-model comparison lives
# in benchmark/REPORT.md instead. See the PROVIDERS comment in that file for
# what was investigated as additional providers.
STT_PROVIDER=sahara

# Intron Sahara speech-to-text API (build-access credentials)
# Docs: https://docs.voice.intron.io

# Required. Get this from your Intron Sahara build-access.
SAHARA_API_KEY=REPLACE_WITH_YOUR_SAHARA_API_KEY

# Sahara's synchronous file-upload endpoint (max 120s audio, returns the
# transcript directly in the response - no polling needed). This default is
# the publicly documented endpoint; override only if Intron gave you a
# different base URL for your build-access.
SAHARA_API_URL=https://infer.voice.intron.io/file/v1/upload/sync

# ASR language code sent as `use_language_asr_input`. Malagasy ("mg") is not
# in Sahara's published language list, so we default to French ("fr") for
# code-switched MG/FR speech and show whatever Sahara actually returns, raw
# and unedited, in the UI - see lib/matchIntent.ts.
SAHARA_ASR_LANGUAGE=fr
